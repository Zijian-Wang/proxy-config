DOMAIN-SUFFIX,gv.163.com,DIRECT
DOMAIN-SUFFIX,uuyc.webapp.163.com,DIRECT
DOMAIN-SUFFIX,uuyc.singleping.com,DIRECT
DOMAIN-SUFFIX,nrd.nie.163.com,DIRECT
DOMAIN-SUFFIX,gameviewer.com,DIRECT
DOMAIN-SUFFIX,api-nrd.dev.webcgi.163.com,DIRECT
DOMAIN-SUFFIX,api-nrd-inner.dev.webcgi.163.com,DIRECT
DOMAIN-SUFFIX,fcount-api.webapp.163.com,DIRECT
DOMAIN-SUFFIX,fcount-api-regtest.webapp.163.com,DIRECT
DOMAIN-SUFFIX,fcount-api.app.guinfra.com,DIRECT
DOMAIN-SUFFIX,shence-api.mumu.163.com,DIRECT
DOMAIN-SUFFIX,adl.netease.com,DIRECT
DOMAIN-SUFFIX,adl.easebar.com,DIRECT
IP-CIDR,123.58.184.232/32,DIRECT
IP-CIDR,42.186.225.155/32,DIRECT

