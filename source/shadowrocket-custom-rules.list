# Custom overrides. Keep these before the base domestic/foreign + ad rules.
# US-only broker services.
DOMAIN-KEYWORD,interactivebrokers,US
DOMAIN-SUFFIX,interactivebrokers.com,US
DOMAIN-SUFFIX,ibkr.com,US
DOMAIN-KEYWORD,thinkorswim,US
DOMAIN-SUFFIX,thinkorswim.com,US
DOMAIN-SUFFIX,schwab.com,US
DOMAIN-SUFFIX,schwabapi.com,US
DOMAIN-SUFFIX,robinhood.com,US
DOMAIN-SUFFIX,fidelity.com,US

# X (Twitter) and its short-link/static domains use the Japan group.
DOMAIN-SUFFIX,x.com,JP
DOMAIN-SUFFIX,twitter.com,JP
DOMAIN-SUFFIX,t.co,JP
DOMAIN-SUFFIX,twimg.com,JP

# Gemini and its supporting Google AI endpoints require a US IP.
DOMAIN-SUFFIX,gemini.google.com,US
DOMAIN-SUFFIX,aistudio.google.com,US
DOMAIN-SUFFIX,ai.google.dev,US
DOMAIN-SUFFIX,generativelanguage.googleapis.com,US

# Tencent Yuanbao core, streaming, CDN, and telemetry endpoints use DIRECT.
DOMAIN-SUFFIX,yuanbao.tencent.com,DIRECT
DOMAIN-SUFFIX,igtm-yuanbao.com,DIRECT
DOMAIN-SUFFIX,aida.qq.com,DIRECT
DOMAIN-SUFFIX,snowflake.qq.com,DIRECT
DOMAIN-SUFFIX,rdelivery.qq.com,DIRECT
DOMAIN-SUFFIX,trace.qq.com,DIRECT
DOMAIN-SUFFIX,rumt-zh.com,DIRECT

# Tonghuashun and iFinD use the local network directly.
DOMAIN-KEYWORD,10jqka,DIRECT
DOMAIN-SUFFIX,10jqka.com.cn,DIRECT
DOMAIN-SUFFIX,10jqka.com,DIRECT
DOMAIN-SUFFIX,51ifind.com,DIRECT

# ToDesk remote desktop: keep Chinese control-plane traffic on DIRECT.
DOMAIN-KEYWORD,todesk,DIRECT
DOMAIN-SUFFIX,todesk.com,DIRECT
DOMAIN-SUFFIX,kylinlot.com,DIRECT
