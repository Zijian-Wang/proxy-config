// Generated by scripts/build_ai_routing.py for Clash Verge Rev on Windows.
// Edit the generator or scripts/verge-subscription-overlay.js.in.
var vergeRoutes = /* ROUTES */;
var vergeAiGroup = "🤖 AI平台";
var vergeUsGroup = "US-Auto";
var vergeJpGroup = "JP-Auto";

function vergeWarn(message) {
  if (typeof console !== "undefined" && typeof console.warn === "function") {
    console.warn("Verge subscription overlay: " + message);
  }
}

function vergeFields(rule) {
  return typeof rule === "string" ? rule.split(",").map(function (part) {
    return part.trim();
  }) : [];
}

function vergeMatcher(fields) {
  var kind = fields[0];
  var value = fields[1] || "";
  if (/^(DOMAIN(?:-SUFFIX|-KEYWORD)?|PROCESS-NAME|IP-CIDR6?)$/.test(kind)) {
    return [kind, value.toLowerCase()].concat(fields.slice(3)).join(",");
  }
}

function vergeGuard(fields) {
  var kind = fields[0];
  var value = (fields[1] || "").toLowerCase();
  var last = fields.length - 1;
  var target = fields[last];
  while (/^(no-resolve|src)$/.test(target)) target = fields[--last];
  // Logical rule operands can contain commas. The outbound still follows them.
  if (/^(REJECT(?:-DROP|-TINYGIF)?)$/.test(target)) return true;
  if (/(?:^|[\s_-])(?:ads?|adblock|adguard|advertising)(?:$|[\s_-])|广告|廣告/i.test(target)) return true;
  if (kind === "RULE-SET" || kind === "GEOSITE" || kind === "GEOIP") {
    return /^(?:(?:geosite|geoip):)?(?:private|lan|local|ads?|anti[-_]ad|adblock|adguard|advertising|category-ads|reject)(?:$|[-_.])/.test(value);
  }
  if (kind === "DOMAIN" || kind === "DOMAIN-SUFFIX") {
    return /(?:^|\.)(?:localhost|local|lan|home\.arpa)$/.test(value);
  }
  if (/^(?:SRC-)?IP-CIDR6?$/.test(kind)) {
    var prefix = Number(value.split("/")[1]);
    return (/^(?:10|127)\./.test(value) && prefix >= 8) ||
      (/^172\.(?:1[6-9]|2\d|3[01])\./.test(value) && prefix >= 12) ||
      (/^192\.168\./.test(value) && prefix >= 16) ||
      (/^169\.254\./.test(value) && prefix >= 16) ||
      (/^100\.(?:6[4-9]|[7-9]\d|1[01]\d|12[0-7])\./.test(value) && prefix >= 10) ||
      value === "::1/128" ||
      (/^f[cd][\da-f]{2}:/.test(value) && prefix >= 7) ||
      (/^fe[89ab][\da-f]:/.test(value) && prefix >= 10);
  }
  return false;
}

function main(config) {
  if (!Array.isArray(config.rules) || config.rules.length === 0) return config;

  var groups = new Set((config["proxy-groups"] || []).map(function (group) {
    return group.name;
  }));
  var ai = groups.has(vergeAiGroup);
  var us = groups.has(vergeUsGroup);
  var jp = groups.has(vergeJpGroup);
  if (!ai) vergeWarn("🤖 AI平台 is missing. AI rules use the subscription routing.");
  if (!us) vergeWarn("US-Auto is missing. Fixed broker rules use REJECT and other US overrides are skipped.");
  if (!jp) vergeWarn("JP-Auto is missing. Other JP overrides are skipped.");

  var local = new Map();
  function add(matchers, target) {
    matchers.forEach(function (matcher) {
      var fields = vergeFields(matcher);
      fields.splice(2, 0, target);
      var key = vergeMatcher(fields);
      if (key === undefined) {
        vergeWarn("Skipped an unsupported personal matcher.");
      } else if (!local.has(key)) {
        local.set(key, fields.join(","));
      }
    });
  }

  // Keep fallback broker rejections at the front of the local block, where
  // the guard scan will find them in the same order if the script is reapplied.
  if (!us) add(vergeRoutes.fixed, "REJECT");
  add(vergeRoutes.first, "DIRECT");
  if (us) add(vergeRoutes.fixed, vergeUsGroup);
  if (ai) add(vergeRoutes.ai, vergeAiGroup);
  if (us) add(vergeRoutes.us, vergeUsGroup);
  if (jp) add(vergeRoutes.jp, vergeJpGroup);
  add(vergeRoutes.direct, "DIRECT");

  var fields = config.rules.map(vergeFields);
  var end = fields.findIndex(function (rule) { return /^(MATCH|FINAL)$/.test(rule[0]); });
  if (end < 0) end = fields.length;

  var guarded = new Set();
  for (var i = 0; i < end; i++) {
    if (vergeGuard(fields[i])) guarded.add(vergeMatcher(fields[i]));
  }
  guarded.forEach(function (key) { local.delete(key); });

  var original = [];
  var insertAt = 0;
  var hasEarlierBroadRule = false;
  var hasBroadRuleBeforeGuard = false;
  for (var i = 0; i < end; i++) {
    if (local.has(vergeMatcher(fields[i]))) continue;
    original.push(config.rules[i]);
    if (vergeGuard(fields[i])) {
      insertAt = original.length;
      hasBroadRuleBeforeGuard = hasEarlierBroadRule;
    } else if (/^(RULE-SET|GEOSITE|GEOIP|DOMAIN-SUFFIX|DOMAIN-KEYWORD|AND|OR|NOT)$/.test(fields[i][0])) {
      hasEarlierBroadRule = true;
    }
  }
  if (hasBroadRuleBeforeGuard) {
    vergeWarn("Broad subscription rules precede LAN or ad rules and may take precedence over local exceptions. Check the runtime rule order.");
  }
  config.rules = original.slice(0, insertAt).concat(
    Array.from(local.values()), original.slice(insertAt), config.rules.slice(end)
  );
  return config;
}
